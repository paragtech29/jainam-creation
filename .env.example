# Neon Postgres connection string.
# Use the POOLED connection string from the Neon dashboard (hostname contains `-pooler`).
# This same pooled string is used for both app runtime and drizzle-kit at this project's scale.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Auth.js v5 secret used to encrypt/sign JWT session tokens.
# NOTE: the v5 env var name is AUTH_SECRET, NOT the v4 NEXTAUTH_SECRET.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-32-byte-base64-secret"

# Required by Auth.js v5 when running behind a reverse proxy / on hosts where the
# request Host header may not be trusted by default (e.g. some deployment targets).
AUTH_TRUST_HOST=true
